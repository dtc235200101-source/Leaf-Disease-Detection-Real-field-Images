# Backend variables are reserved for a later serving phase.
TDET_DEVICE=auto
TDET_DEFAULT_MODEL=yolo11s_coco
TDET_HOST=127.0.0.1
TDET_PORT=8000
TDET_MAX_FRAME_BYTES=4000000
TDET_MAX_UPLOAD_BYTES=10000000
TDET_MAX_IMAGE_PIXELS=16000000
TDET_MAX_DETECTIONS=100
TDET_MAX_LOADED_MODELS=1
TDET_LOG_LEVEL=INFO
# Per-deployment checkpoint override, e.g. when serving a graph outside the
# committed deploy/model/best.onnx path.
# TDET_CHECKPOINT_YOLO11S_COCO=weights/yolo11s_coco/best.onnx
